<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="provider_secrets.xml" />
        <exclude domain="sharedpref" path="env_var_values.xml" />
        <exclude domain="sharedpref" path="mcp_oauth_secrets.xml" />
        <exclude domain="sharedpref" path="minis_device_identity.xml" />
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="*_plain_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="sessions/" />
        <exclude domain="file" path="minis-sessions/" />
        <!-- [fix/sweep1014-debug-backup D3a] proot/ matched no directory —
             the rootfs lives at alpine-rootfs/ (RootfsManager.kt), tokenizer
             at jieba/, user media offloads at media/. -->
        <exclude domain="file" path="alpine-rootfs/" />
        <exclude domain="file" path="jieba/" />
        <exclude domain="file" path="media/" />
        <exclude domain="file" path="share_extension/" />
        <exclude domain="file" path="minis-global/" />
        <exclude domain="file" path="debug_server_token" />
        <exclude domain="cache" path="" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="provider_secrets.xml" />
        <exclude domain="sharedpref" path="env_var_values.xml" />
        <exclude domain="sharedpref" path="mcp_oauth_secrets.xml" />
        <exclude domain="sharedpref" path="minis_device_identity.xml" />
        <exclude domain="sharedpref" path="webdav_config.xml" />
        <exclude domain="sharedpref" path="*_plain_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="sessions/" />
        <exclude domain="file" path="minis-sessions/" />
        <!-- [fix/sweep1014-debug-backup D3a] proot/ matched no directory —
             the rootfs lives at alpine-rootfs/ (RootfsManager.kt), tokenizer
             at jieba/, user media offloads at media/. -->
        <exclude domain="file" path="alpine-rootfs/" />
        <exclude domain="file" path="jieba/" />
        <exclude domain="file" path="media/" />
        <exclude domain="file" path="share_extension/" />
        <exclude domain="file" path="minis-global/" />
        <exclude domain="file" path="debug_server_token" />
        <exclude domain="cache" path="" />
    </device-transfer>
</data-extraction-rules>